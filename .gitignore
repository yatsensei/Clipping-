# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# FastF1 telemetry cache — ~1.2 GB after a full calendar build, and reproducible by
# re-running scripts/. Never commit it.
data/cache/

# Processed artifacts are committed selectively; probe scratch output is not.
data/processed/coverage_probe.csv

# Intermediate telemetry tables (~35 MB), rebuilt by `python -m data.dynamics` from the
# FastF1 cache in ~2 minutes. The circuit geometry and the fit results they produce ARE
# committed, so the repository stays runnable without them.
data/processed/*.parquet
